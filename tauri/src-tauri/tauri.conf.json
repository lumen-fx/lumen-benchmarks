{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bench-tauri",
  "version": "0.1.0",
  "identifier": "dev.lumenui.bench-tauri",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bench",
        "width": 800,
        "height": 600,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
